{
  "name": "saas-web-starter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply saas-web-starter --local",
    "db:migrate:remote": "wrangler d1 migrations apply saas-web-starter --remote",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "typecheck": "tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p src/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --project unit --project web --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:server": "cp -n e2e/dev.vars .dev.vars; rm -rf .wrangler/e2e && wrangler d1 migrations apply saas-web-starter --local --persist-to .wrangler/e2e && E2E_PERSIST=.wrangler/e2e vite dev --port 5173",
    "lint": "biome check .",
    "lint:arch": "depcruise server/ shared/ src/ --config .dependency-cruiser.cjs",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "cf-typegen": "wrangler types server/worker-configuration.d.ts --include-runtime=false --env-file .dev.vars.example",
    "postinstall": "wrangler types server/worker-configuration.d.ts --include-runtime=false --env-file .dev.vars.example",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hono/zod-validator": "^0.9.0",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "i18next": "^26.3.6",
    "jose": "^6.2.4",
    "lucide-react": "^1.26.0",
    "oidc-client-ts": "^3.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-router": "^8.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@cloudflare/vite-plugin": "^1.47.0",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260724.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.2",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^18.1.0",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^17.2.0",
    "msw": "^2.15.0",
    "shadcn": "^4.14.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "workerd"
    ]
  },
  "volta": {
    "node": "24.14.1",
    "pnpm": "10.30.2"
  },
  "lint-staged": {
    "*.{ts,tsx,json,jsonc}": "biome check --write --no-errors-on-unmatched"
  }
}
