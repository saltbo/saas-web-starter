{
  "name": "saas-web-starter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "void deploy --platform cloudflare",
    "db:migrate:local": "void db migrate",
    "db:generate": "void db generate",
    "typecheck": "void prepare && tsc --noEmit",
    "test": "pnpm test:fast && pnpm test:integration",
    "test:fast": "vitest run --project unit --project web",
    "test:integration": "node scripts/integration.mjs",
    "test:coverage": "vitest run --project unit --project web --coverage",
    "test:behavior": "node scripts/check-behavior-coverage.mjs",
    "test:watch": "vitest --project unit --project web",
    "verify": "pnpm lint && pnpm lint:arch && pnpm typecheck && pnpm test:behavior && pnpm test && pnpm test:coverage && pnpm build",
    "e2e": "node e2e/run.mjs",
    "lint": "biome check .",
    "lint:arch": "depcruise server/ shared/ src/ routes/ middleware/ db/schema.ts --config .dependency-cruiser.cjs",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "postinstall": "void prepare",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@tanstack/react-query": "^5.101.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "i18next": "^26.3.1",
    "jose": "^6.1.0",
    "lucide-react": "^0.577.0",
    "oidc-client-ts": "^3.3.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.8",
    "react-router": "^7.16.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.4.10",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.8",
    "dependency-cruiser": "^17.4.3",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.1.2",
    "msw": "^2.14.6",
    "shadcn": "^4.10.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.2",
    "void": "1.1.11",
    "wrangler": "^4.151.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "workerd",
      "sharp",
      "blake3-jit"
    ]
  },
  "volta": {
    "node": "24.21.0",
    "pnpm": "10.30.2"
  },
  "lint-staged": {
    "*.{ts,tsx,json,jsonc}": "biome check --write --no-errors-on-unmatched"
  }
}
